<?xml version="1.0" encoding="UTF-8"?>
<!--
  GPU Vision-Language Model (Qwen2.5-VL-7B-Instruct, Apache-2.0) 4-bit QLoRA training and inference configuration.
-->
<gpu-vlm version="1">
  <base-model repo-id="Qwen/Qwen2.5-VL-7B-Instruct"
              revision="cc594898137f460bfe9f0759e9844b3ce807cfb5"
              adapter-dir="models/gpu/qwen25_vl_7b_filament_lora"
              min-pixels="200704"
              max-pixels="1003520"/>

  <lora r="16" alpha="32" dropout="0.05" bias="none">
    <target-module>q_proj</target-module>
    <target-module>k_proj</target-module>
    <target-module>v_proj</target-module>
    <target-module>o_proj</target-module>
    <target-module>gate_proj</target-module>
    <target-module>up_proj</target-module>
    <target-module>down_proj</target-module>
  </lora>

  <training device="cuda:0" precision="bf16" epochs="3" batch-size="2"
            grad-accum="4" lr="0.0002" warmup-ratio="0.05" max-seq-length="1536"/>

  <inference default-device="cuda:0" low-vram-4bit="true" max-new-tokens="512"
             temperature="0.05" idle-unload-seconds="300"/>
</gpu-vlm>
