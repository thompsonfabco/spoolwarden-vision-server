[Unit]
Description=Filament Vision Server (Standalone Spool Recognition Service)
After=network.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__PREFIX__
Environment="FILAMENT_VISION_SERVER_HOME=__PREFIX__"
Environment="FILAMENT_VISION_SERVER_STATE_DIR=__STATE_DIR__"
Environment="FILAMENT_VISION_SERVER_HOST=__BIND__"
Environment="FILAMENT_VISION_SERVER_PORT=__PORT__"
Environment="FILAMENT_VISION_SERVER_TIER=__TIER__"
Environment="XDG_CACHE_HOME=__STATE_DIR__/cache"
Environment="HOME=__STATE_DIR__"
EnvironmentFile=-/etc/filament-vision-server/env
ExecStart=__PREFIX__/.venv/bin/filament-vision-server serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=__STATE_DIR__

[Install]
WantedBy=multi-user.target
